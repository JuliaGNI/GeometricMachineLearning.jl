# macOS file system data
.DS_Store

# Files generated by invoking Julia with --code-coverage
*.jl.cov
*.jl.*.cov

# Files generated by invoking Julia with --track-allocation
*.jl.mem
*.jl.*.mem

# Figures generated by example scripts
*.png

# The logo, built from docs/src/tikz/ by the `logo` target of its Makefile. The manual's other
# figures are covered by the bare *.png above; the logo is vector, so it needs naming. The three
# patterns are exact rather than a *.svg/*.pdf sweep, because docs/src/assets/logo_tum.pdf is a
# tracked file sitting beside them.
/docs/src/assets/logo.svg
/docs/src/assets/logo-dark.svg
/docs/src/assets/logo_without_jl.pdf
/docs/src/tikz/*.svg

# xelatex writes one .pdf per .tex under docs/src/tikz/, and the Makefile's `clean` target removes
# them at the end of a full run. An interrupted run leaves 68 untracked files behind without this.
/docs/src/tikz/*.pdf

# Data generated by the scripts
# scripts/reproduction/symplectic_autoencoders/integration.jl passes a bare
# relative name to h5open, so its snapshot matrix lands in the process working
# directory rather than beside the script: at the repository root, or in the
# script's own directory, depending on where the script is started from.
/snapshot_matrix*.h5
scripts/**/*.h5
# Both patterns are anchored or scoped so that neither can reach
# docs/src/tutorials/, where the committed network weights are .h5 too and must
# remain tracked.
#
# The reproduction scripts also write network weights as .jld2 and figures as
# .pdf. Nothing tracked under scripts/ has either extension, and the CI job in
# Scripts.yml runs every one of these scripts, so without these two patterns a
# gate run leaves the tree dirty.
scripts/**/*.jld2
scripts/**/*.pdf

# Files generated by weave documents
build/

# Files generated by Jupyter notebook
.ipynb_checkpoints

# System-specific files and directories generated by the BinaryProvider and BinDeps packages
# They contain absolute paths specific to the host computer, and so should not be committed
deps/deps.jl
deps/build.log
deps/downloads/
deps/usr/
deps/src/

# Build artifacts for creating documentation generated by the Documenter package
docs/build/
docs/site/
docs/build*.zip
# LaTeX build artifacts next to the .tex sources
*.aux
*.fls
*.fdb_latexmk
*.out
docs/**/*.log

# File generated by Pkg, the package manager, based on a corresponding Project.toml
# It records a fixed state of all packages used by the project. As such, it should not be
# committed for packages, but should be committed for applications that require a static
# environment.
Manifest.toml
